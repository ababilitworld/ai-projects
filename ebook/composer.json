{
  "name": "ababil/ait-publishing-system",
  "description": "File-based professional terminal, generic eBook and print publishing system.",
  "type": "project",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "AIT\\Publishing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AIT\\Publishing\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "serve": "php -S localhost:8080 -t public"
  }
}