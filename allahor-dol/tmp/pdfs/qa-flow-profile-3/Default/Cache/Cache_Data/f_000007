    box-shadow:0 10px 30px color-mix(in srgb,var(--aod2-primary) 15%,transparent);
  }

  .aod2-sheet::before{
    content:"";
    inset:10px;
    width:auto;
    height:auto;
    display:block;
    border:4px double var(--aod2-page-frame);
    border-radius:0;
    background:transparent;
    box-shadow:none;
    opacity:1;
    transform:none;
    mask-image:none;
    pointer-events:none;
  }

  .aod2-sheet::after{
    content:"";
    inset:var(--aod2-page-inner-inset);
    width:auto;
    height:auto;
    display:block;
    border:1px solid var(--aod2-page-frame-soft);
    border-radius:0;
    background:transparent;
    box-shadow:none;
    opacity:1;
    transform:none;
    pointer-events:none;
