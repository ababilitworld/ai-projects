*{box-sizing:border-box}
html{scroll-behavior:smooth;background:var(--aod2-bg-2)}
body{margin:0;background:var(--aod2-bg);color:var(--aod2-ink);font-family:"Noto Sans Bengali","Nirmala UI","Hind Siliguri",system-ui,sans-serif;transition:background .3s ease,color .3s ease}
button,input,select{font:inherit}
button{color:inherit}
a{color:inherit}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--aod2-gold);outline-offset:3px}
[hidden]{display:none!important}

:root{--aod2-reader-size:20px;--aod2-reader-leading:2}
:root[data-aod2-font="classic"] .aod2-reader{font-family:"Noto Serif Bengali","Nirmala UI",Georgia,serif}
:root[data-aod2-font="modern"] .aod2-reader{font-family:"Noto Sans Bengali","Nirmala UI",system-ui,sans-serif}
:root[data-aod2-font="book"] .aod2-reader{font-family:Kalpurush,SolaimanLipi,"Nirmala UI",serif}
:root[data-aod2-font="ait-pha"] .aod2-reader{font-family:"Noto Sans Bengali","Hind Siliguri",SolaimanLipi,"Nirmala UI",system-ui,sans-serif}

.aod2-skip{position:fixed;z-index:1000;top:-70px;left:20px;padding:11px 17px;border-radius:0 0 10px 10px;background:var(--aod2-primary);color:#fff;text-decoration:none;font-size:13px;transition:top .2s ease}
.aod2-skip:focus{top:0}
.aod2-progress{position:fixed;z-index:502;top:0;left:0;right:0;height:3px;background:rgba(0,0,0,.06)}
.aod2-progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--aod2-primary),var(--aod2-gold));transition:width .08s linear}

.aod2-topbar{position:fixed;z-index:500;top:17px;left:50%;width:min(1210px,calc(100% - 46px));min-height:64px;padding:8px 9px 8px 14px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;border:1px solid var(--aod2-line);border-radius:17px;background:color-mix(in srgb,var(--aod2-paper) 88%,transparent);box-shadow:0 12px 38px var(--aod2-shadow);backdrop-filter:blur(18px) saturate(120%);transform:translateX(-50%)}
.aod2-brand{width:max-content;padding:0;display:flex;align-items:center;gap:10px;border:0;background:none;text-align:left;cursor:pointer}
.aod2-brand__seal{width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--aod2-gold);border-radius:50%;background:radial-gradient(circle,var(--aod2-paper) 0 36%,transparent 38%),repeating-conic-gradient(var(--aod2-gold) 0 10deg,var(--aod2-gold-2) 10deg 20deg);box-shadow:inset 0 0 0 4px var(--aod2-paper);color:var(--aod2-primary-deep);font:15px Georgia,serif}
.aod2-brand>span:last-child{display:grid}
.aod2-brand strong{font-size:15px;line-height:1.25}
.aod2-brand small{color:var(--aod2-muted);font:600 8px/1.4 ui-monospace,monospace;letter-spacing:.13em}
.aod2-read-state{display:flex;align-items:center;gap:10px;color:var(--aod2-muted);font-size:11px}
.aod2-read-state__dot{width:7px;height:7px;border-radius:50%;background:#2ca46f;box-shadow:0 0 0 4px rgba(44,164,111,.13)}
.aod2-read-state b{padding:5px 8px;border-radius:7px;background:var(--aod2-primary-soft);color:var(--aod2-primary);font:700 10px ui-monospace,monospace}
.aod2-topbar__actions{justify-self:end;display:flex;align-items:center;gap:7px}
.aod2-download{min-height:44px;padding:0 13px;display:flex;align-items:center;gap:7px;border:1px solid var(--aod2-line);border-radius:11px;background:var(--aod2-paper-2);color:var(--aod2-primary);text-decoration:none;font:700 10px ui-monospace,monospace}
.aod2-download:hover{border-color:var(--aod2-gold);background:var(--aod2-paper)}
.aod2-download>span:first-child{font-size:19px}
.aod2-terminal-trigger{min-height:44px;padding:0 8px 0 13px;display:flex;align-items:center;gap:8px;border:0;border-radius:11px;background:var(--aod2-terminal);color:var(--aod2-terminal-text);box-shadow:0 7px 18px rgba(0,0,0,.2);cursor:pointer;font:650 11px ui-monospace,monospace}
.aod2-terminal-trigger__icon{width:21px;height:21px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.17);border-radius:6px;color:var(--aod2-gold-2)}
.aod2-terminal-trigger kbd{margin-left:6px;padding:5px 7px;border:1px solid rgba(255,255,255,.14);border-radius:6px;background:rgba(255,255,255,.07);color:var(--aod2-terminal-muted);font:700 9px ui-monospace,monospace}

.aod2-rail{position:fixed;z-index:150;top:50%;right:max(12px,calc((100vw - 1310px)/2));display:flex;flex-direction:column;align-items:center;gap:5px;transform:translateY(-50%)}
.aod2-rail__track{width:1px;height:22px;margin:2px 0;background:linear-gradient(transparent,var(--aod2-line),transparent)}
.aod2-rail button{position:relative;width:29px;height:29px;padding:0;display:grid;place-items:center;border:0;border-radius:50%;background:transparent;color:var(--aod2-muted);cursor:pointer;transition:.2s ease}
.aod2-rail button::before{content:"";position:absolute;width:5px;height:5px;border-radius:50%;background:currentColor}
.aod2-rail button span{font:700 8px ui-monospace,monospace;opacity:0;transform:scale(.75);transition:.2s ease}
.aod2-rail button:hover,.aod2-rail button.is-active{background:var(--aod2-primary);color:#fff;box-shadow:0 5px 14px color-mix(in srgb,var(--aod2-primary) 28%,transparent)}
.aod2-rail button:hover::before,.aod2-rail button.is-active::before{opacity:0}
.aod2-rail button:hover span,.aod2-rail button.is-active span{opacity:1;transform:scale(1)}

.aod2-reader{width:min(1040px,calc(100% - 66px));margin:0 auto;padding:116px 0 35px;font-size:var(--aod2-reader-size);line-height:var(--aod2-reader-leading)}
.aod2-sheet{position:relative;min-height:850px;margin:0 0 32px;padding:clamp(50px,7vw,86px) clamp(42px,8vw,90px) 48px;border:1px solid var(--aod2-line);border-radius:5px 20px 20px 5px;background:linear-gradient(90deg,color-mix(in srgb,var(--aod2-primary) 5%,transparent),transparent 7%,transparent 95%,color-mix(in srgb,var(--aod2-gold) 4%,transparent)),var(--aod2-paper);box-shadow:-8px 11px 0 color-mix(in srgb,var(--aod2-paper-3) 72%,transparent),0 23px 65px var(--aod2-shadow);scroll-margin-top:105px;overflow:hidden}
.aod2-sheet::before{content:"";position:absolute;z-index:0;inset:13px;pointer-events:none;border:1px solid color-mix(in srgb,var(--aod2-gold) 40%,transparent);border-radius:3px 14px 14px 3px}
.aod2-sheet::after{content:"";position:absolute;z-index:0;right:18px;top:18px;width:72px;height:72px;pointer-events:none;border-top:2px solid var(--aod2-gold);border-right:2px solid var(--aod2-gold);border-radius:0 11px 0 0;opacity:.6}
.aod2-sheet>*{position:relative;z-index:1}
.aod2-sheet--wide{width:calc(100% + 70px);margin-left:-35px}
.aod2-sheet__frame{position:absolute;z-index:0;inset:25px;border:1px solid var(--aod2-line);border-radius:2px 10px 10px 2px;pointer-events:none}
.aod2-sheet__folio{position:absolute;z-index:2;left:52px;right:52px;bottom:26px;display:flex;align-items:center;justify-content:center;gap:11px;color:var(--aod2-gold);font:600 9px ui-monospace,monospace;letter-spacing:.11em}
.aod2-sheet__folio::before,.aod2-sheet__folio::after{content:"";width:72px;height:1px;background:linear-gradient(90deg,transparent,var(--aod2-line))}
.aod2-sheet__folio::after{background:linear-gradient(90deg,var(--aod2-line),transparent)}
.aod2-sheet__folio b{color:var(--aod2-muted);font-size:8px}

.aod2-cover{min-height:calc(100vh - 140px);padding-block:66px;background:radial-gradient(circle at 50% 28%,color-mix(in srgb,var(--aod2-gold) 10%,transparent),transparent 28%),linear-gradient(90deg,color-mix(in srgb,var(--aod2-primary) 4%,transparent),transparent 8%),var(--aod2-paper)}
.aod2-cover__content{min-height:680px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.aod2-cover__mark{position:relative;width:150px;height:150px;margin-bottom:35px;display:grid;place-items:center;border:1px dashed color-mix(in srgb,var(--aod2-gold) 60%,transparent);border-radius:50%;color:var(--aod2-gold);font:34px Georgia,serif}
.aod2-cover__mark::before,.aod2-cover__mark::after{content:"";position:absolute;inset:18px;border:1px solid color-mix(in srgb,var(--aod2-gold) 46%,transparent);border-radius:28px;transform:rotate(45deg)}
.aod2-cover__mark::after{inset:33px;border-radius:50%;transform:none;background:var(--aod2-primary-soft);box-shadow:0 0 40px color-mix(in srgb,var(--aod2-primary) 12%,transparent)}
.aod2-cover__mark span{position:relative;z-index:2}
.aod2-cover__mark i{position:absolute;width:1px;height:190px;background:linear-gradient(transparent,var(--aod2-gold),transparent);opacity:.3}
.aod2-cover__mark i:last-child{transform:rotate(90deg)}
.aod2-kicker{margin:0 0 9px;color:var(--aod2-gold);font:700 9px ui-monospace,monospace;letter-spacing:.18em}
.aod2-cover h1{margin:0;color:var(--aod2-primary);font-size:clamp(72px,10vw,118px);font-weight:800;line-height:1.05;letter-spacing:-.06em;text-wrap:balance}
.aod2-flourish{width:min(450px,72%);margin:31px 0;display:flex;align-items:center;gap:17px;color:var(--aod2-gold);font:20px Georgia,serif}
.aod2-flourish i{flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--aod2-gold),transparent)}
.aod2-cover__statement{max-width:700px;margin:0;color:var(--aod2-muted);font-size:.95em;line-height:2.05}
.aod2-start{margin-top:37px;padding:10px 11px 10px 18px;display:flex;align-items:center;gap:14px;border:1px solid var(--aod2-line);border-radius:999px;background:var(--aod2-paper-2);color:var(--aod2-primary);font-size:11px;font-weight:700;cursor:pointer}
.aod2-start b{width:31px;height:31px;display:grid;place-items:center;border-radius:50%;background:var(--aod2-primary);color:#fff}

.aod2-section-head{margin:0 0 45px;display:grid;grid-template-columns:72px 1fr;gap:24px;align-items:start}
.aod2-section-head>div{padding-top:7px;display:grid;justify-items:start}
.aod2-section-head>div span{width:45px;height:45px;display:grid;place-items:center;border:1px solid var(--aod2-line);border-radius:13px;background:var(--aod2-primary-soft);color:var(--aod2-primary);font:750 11px ui-monospace,monospace}
.aod2-section-head>div small{margin-top:8px;color:var(--aod2-muted);font:600 8px ui-monospace,monospace;letter-spacing:.09em;white-space:nowrap}
.aod2-section-head h2{max-width:760px;margin:0;color:var(--aod2-primary);font-size:clamp(32px,4.7vw,51px);font-weight:760;line-height:1.33;letter-spacing:-.028em;text-wrap:balance}
.aod2-section-head h2::after{content:"";display:block;width:92px;height:4px;margin-top:19px;border-radius:8px;background:linear-gradient(90deg,var(--aod2-gold),var(--aod2-gold-2),transparent)}
.aod2-opening{margin:0 0 33px;color:var(--aod2-ink);font-size:1.02em;line-height:var(--aod2-reader-leading)}

.aod2-compare{display:grid;grid-template-columns:1fr 1fr;gap:17px}
.aod2-compare__card{position:relative;min-height:310px;padding:27px 27px 28px;display:flex;flex-direction:column;border:1px solid var(--aod2-line);border-radius:19px;background:var(--aod2-paper-2);overflow:hidden}
.aod2-compare__card::after{content:"";position:absolute;right:-38px;bottom:-50px;width:145px;height:145px;border:1px solid var(--aod2-line);border-radius:50%}
.aod2-compare__card--primary{background:linear-gradient(145deg,var(--aod2-primary-soft),var(--aod2-paper))}
.aod2-compare__card--primary{border-color:color-mix(in srgb,var(--aod2-primary) 30%,transparent)}
.aod2-compare__card--contrast{background:linear-gradient(145deg,color-mix(in srgb,var(--aod2-contrast) 8%,var(--aod2-paper)),var(--aod2-paper))}
.aod2-compare__number{display:flex;align-items:center;justify-content:space-between;color:var(--aod2-muted)}
.aod2-compare__number span{font:750 12px ui-monospace,monospace;letter-spacing:.1em}
.aod2-compare__number i{font-style:normal;font-size:17px}
.aod2-compare__card p{margin:auto 0 0;font-size:1em;line-height:1.95}
.aod2-compare__card--primary p{color:var(--aod2-primary-deep)}
.aod2-question{margin-top:26px;padding:24px 27px;display:grid;grid-template-columns:50px 1fr;gap:20px;align-items:center;border:1px solid color-mix(in srgb,var(--aod2-gold) 45%,transparent);border-radius:16px;background:linear-gradient(120deg,color-mix(in srgb,var(--aod2-gold) 12%,var(--aod2-paper)),var(--aod2-paper))}
.aod2-question>span{width:50px;height:50px;display:grid;place-items:center;border-radius:50%;background:var(--aod2-gold);color:var(--aod2-primary-deep);font:800 24px Georgia,serif}
.aod2-question p{margin:0;color:var(--aod2-primary);font-size:1.18em;font-weight:700;line-height:1.75}

.aod2-lessons{position:relative;display:grid;gap:13px}
.aod2-lessons::before{content:"";position:absolute;left:30px;top:33px;bottom:33px;width:1px;background:linear-gradient(var(--aod2-gold),var(--aod2-line),var(--aod2-gold))}
.aod2-lesson{position:relative;display:grid;grid-template-columns:62px 1fr;gap:19px}
.aod2-lesson__index{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center}
.aod2-lesson__index span{width:61px;height:61px;display:grid;place-items:center;border:1px solid var(--aod2-line);border-radius:50%;background:var(--aod2-paper);color:var(--aod2-primary);box-shadow:0 7px 18px color-mix(in srgb,var(--aod2-shadow) 45%,transparent);font:750 10px ui-monospace,monospace}
.aod2-lesson>div:last-child{padding:22px 25px;display:grid;grid-template-columns:28px 1fr;gap:10px;border:1px solid var(--aod2-line);border-radius:16px;background:var(--aod2-paper-2)}
.aod2-bolt{padding-top:4px;color:var(--aod2-gold);font-size:17px}
.aod2-lesson p{margin:0}

.aod2-check-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.aod2-check-grid article{min-height:165px;padding:22px;display:grid;grid-template-columns:34px 1fr;gap:12px;align-content:start;align-items:start;border:1px solid var(--aod2-line);border-radius:15px;background:var(--aod2-paper-2)}
.aod2-check-grid article>span,.aod2-next-note__num{width:30px;height:30px;display:grid;place-items:center;align-self:start;border:1px solid var(--aod2-gold);border-radius:4px;background:var(--aod2-paper);color:var(--aod2-primary);font:750 12px/1 "Noto Sans Bengali","Nirmala UI",sans-serif}
.aod2-check-grid p{margin:0;padding:0;align-self:start;font-size:.97em;line-height:1.9}
.aod2-check-grid article:last-child{grid-column:1/-1;min-height:auto;background:linear-gradient(110deg,var(--aod2-primary-soft),var(--aod2-paper))}
.aod2-next-note{margin-top:14px;padding:19px 22px;display:grid;grid-template-columns:34px minmax(0,1fr) 35px;gap:12px;align-items:start;border:1px solid color-mix(in srgb,var(--aod2-gold) 40%,transparent);border-radius:13px;background:var(--aod2-paper)}
.aod2-next-note p{margin:0;padding:0;align-self:start;font-weight:700;line-height:1.9;color:var(--aod2-primary)}
.aod2-next-note b{width:33px;height:33px;display:grid;place-items:center;align-self:start;border-radius:50%;background:var(--aod2-primary);color:#fff}

.aod2-section-head--roadmap{margin-bottom:35px}
.aod2-roadmap{position:relative;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;list-style:none}
.aod2-roadmap::before{content:"";position:absolute;left:50%;top:12px;bottom:12px;width:1px;background:linear-gradient(transparent,var(--aod2-line),transparent)}
.aod2-roadmap li{position:relative;min-height:117px;padding:13px;display:grid;grid-template-columns:50px 1fr;gap:12px;border:1px solid var(--aod2-line);border-radius:14px;background:var(--aod2-paper-2);transition:transform .2s ease,border-color .2s ease}
.aod2-roadmap li:hover{transform:translateY(-2px);border-color:var(--aod2-gold)}
.aod2-roadmap li:last-child{grid-column:1/-1;max-width:calc(50% - 7px);justify-self:center}
.aod2-roadmap__num{width:48px;height:48px;display:grid;place-items:center;border-radius:13px;background:var(--aod2-primary);color:#fff;box-shadow:0 7px 15px color-mix(in srgb,var(--aod2-primary) 22%,transparent);font:800 13px ui-monospace,monospace}
.aod2-roadmap li>div{display:grid;grid-template-columns:22px 1fr;gap:7px;align-items:start}
.aod2-roadmap li i{padding-top:2px;color:var(--aod2-gold);font:normal 16px Georgia,serif}
.aod2-roadmap li p{margin:0;font-size:.88em;line-height:1.85}

.aod2-special{margin-bottom:26px;padding:20px 23px;display:flex;align-items:center;gap:16px;border-radius:13px;background:var(--aod2-primary);color:#fff;box-shadow:0 12px 28px color-mix(in srgb,var(--aod2-primary) 22%,transparent)}
.aod2-special span{color:var(--aod2-gold-2);font:18px Georgia,serif;white-space:nowrap}
.aod2-special p{margin:0;font-weight:700}
.aod2-benefit-card{overflow:hidden;border:1px solid var(--aod2-line);border-radius:15px;background:var(--aod2-paper);box-shadow:0 12px 30px color-mix(in srgb,var(--aod2-shadow) 28%,transparent)}
.aod2-benefit-card__head{min-height:54px;padding:12px 18px;display:flex;align-items:center;border-bottom:1px solid var(--aod2-line);background:linear-gradient(90deg,var(--aod2-primary),color-mix(in srgb,var(--aod2-primary) 82%,var(--aod2-terminal)));color:#fff}
.aod2-benefit-card__head h3{margin:0;font-size:1.12em;font-weight:760;line-height:1.35}
.aod2-benefit-copy{padding:14px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;align-items:stretch}
.aod2-benefit-copy>.aod2-opening,.aod2-benefit-copy>.aod2-equation{width:100%;height:100%;margin:0!important}
.aod2-benefit-card--primary-tip .aod2-benefit-copy,.aod2-benefit-copy--knowledge{grid-template-columns:minmax(0,1.62fr) minmax(235px,.88fr)}
.aod2-benefit-card--primary-tip .aod2-benefit-copy>.aod2-equation{padding:18px 12px;gap:9px}
.aod2-benefit-card--primary-tip .aod2-benefit-copy>.aod2-equation strong{font-size:clamp(26px,3vw,38px)}
.aod2-benefit-card--primary-tip .aod2-benefit-copy>.aod2-equation>span{font-size:20px}
.aod2-benefit-card--primary-tip .aod2-benefit-copy>.aod2-equation .aod2-equation__result{padding:12px 10px}
.aod2-benefit-card--secondary-tip{margin-top:14px}
.aod2-benefit-card--secondary-tip .aod2-benefit-card__head{min-height:58px}
.aod2-equation.aod2-log-equation{padding:17px 13px!important;display:grid;grid-template-columns:1fr;gap:6px!important;align-content:center;justify-items:center;text-align:center}
.aod2-binary-method__title{width:100%;padding-bottom:7px;border-bottom:1px solid color-mix(in srgb,var(--aod2-formula-accent) 38%,transparent);color:var(--aod2-formula-accent)!important;font:800 8px/1 ui-monospace,monospace!important;letter-spacing:.16em}
.aod2-binary-method__power{width:100%;padding:8px 6px;gap:4px;border-radius:7px;background:color-mix(in srgb,var(--aod2-formula-ink) 6%,transparent)}
.aod2-binary-method__power>strong{color:var(--aod2-formula-ink)!important;font:800 clamp(17px,2.1vw,22px)/1.15 ui-monospace,monospace!important}
.aod2-binary-method__power>small{margin:0!important;color:var(--aod2-formula-muted);font:650 8px/1.35 ui-monospace,monospace}
.aod2-binary-method__divider{width:62%;height:1px;background:linear-gradient(90deg,transparent,var(--aod2-formula-accent),transparent)}
.aod2-log-equation>.aod2-log-equation__expression{color:var(--aod2-formula-ink);font:750 clamp(17px,2.3vw,24px)/1.2 ui-monospace,monospace;white-space:nowrap}
.aod2-log-equation>.aod2-log-equation__approx{color:var(--aod2-formula-accent);font:700 22px/1 ui-monospace,monospace}
.aod2-log-equation>.aod2-equation__result{min-width:112px;padding:10px 14px;border-radius:10px}
.aod2-log-equation>.aod2-equation__result strong{font-size:clamp(27px,3vw,38px)}
.aod2-log-equation>.aod2-equation__result small{margin-top:5px}
.aod2-equation{--aod2-formula-surface:linear-gradient(135deg,var(--aod2-primary-soft),var(--aod2-paper));--aod2-formula-border:color-mix(in srgb,var(--aod2-gold) 46%,transparent);--aod2-formula-ink:var(--aod2-primary);--aod2-formula-muted:var(--aod2-muted);--aod2-formula-accent:var(--aod2-gold);--aod2-formula-result-bg:var(--aod2-primary);--aod2-formula-result-ink:var(--aod2-paper);margin:40px auto 0;padding:29px;display:flex;align-items:center;justify-content:center;gap:clamp(13px,4vw,36px);border:1px solid var(--aod2-formula-border);border-radius:21px;background:var(--aod2-formula-surface);box-shadow:0 12px 32px color-mix(in srgb,var(--aod2-shadow) 35%,transparent)}
.aod2-equation>div{display:grid;justify-items:center}
.aod2-equation strong{color:var(--aod2-formula-ink);font:800 clamp(33px,6vw,58px)/1 ui-monospace,monospace}
.aod2-equation small{margin-top:9px;color:var(--aod2-formula-muted);font-size:10px}
.aod2-equation>span{color:var(--aod2-formula-accent);font:400 26px ui-monospace,monospace}
.aod2-equation__result{padding:16px 20px;border-radius:14px;background:var(--aod2-formula-result-bg)}
.aod2-equation__result strong,.aod2-equation__result small{color:var(--aod2-formula-result-ink)}

.aod2-quote{position:relative;margin:0 0 25px;padding:32px 34px 32px 63px;border:1px solid color-mix(in srgb,var(--aod2-gold) 42%,transparent);border-radius:5px 18px 18px 5px;background:linear-gradient(110deg,var(--aod2-primary-soft),var(--aod2-paper));color:var(--aod2-primary-deep)}
.aod2-quote>span{position:absolute;left:-20px;top:50%;width:41px;height:41px;display:grid;place-items:center;border-radius:50%;background:var(--aod2-gold);color:var(--aod2-primary-deep);box-shadow:0 6px 16px var(--aod2-shadow);font:19px Georgia,serif;transform:translateY(-50%)}
.aod2-quote p{margin:0;font-size:1.08em;font-weight:700;line-height:1.9}
.aod2-prose-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.aod2-prose-grid article{padding:20px;display:grid;grid-template-columns:34px 1fr;gap:12px;border-bottom:1px solid var(--aod2-line);background:linear-gradient(90deg,var(--aod2-paper-2),transparent);border-radius:8px}
.aod2-prose-grid article>span{padding-top:2px;color:var(--aod2-gold);font:750 9px ui-monospace,monospace}
.aod2-prose-grid p{margin:0;font-size:.92em;line-height:1.9}
.aod2-behaviour{margin-top:25px;display:grid;gap:10px}
.aod2-behaviour__line{padding:19px 21px;display:grid;grid-template-columns:31px 1fr;gap:11px;border:1px solid var(--aod2-line);border-radius:12px;background:var(--aod2-paper-2)}
.aod2-behaviour__line>span{color:var(--aod2-gold);font:17px Georgia,serif}
.aod2-behaviour__line p{margin:0;font-size:.93em;line-height:1.9}
.aod2-behaviour__line--strong{background:var(--aod2-primary);color:#fff;border-color:var(--aod2-primary)}
.aod2-behaviour__line--strong>span{color:var(--aod2-gold-2)}
.aod2-behaviour__line--strong p{font-weight:700}

.aod2-purpose{min-height:360px;padding:48px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:27px;border:1px solid color-mix(in srgb,var(--aod2-gold) 45%,transparent);border-radius:22px;background:radial-gradient(circle at 50% 0,color-mix(in srgb,var(--aod2-gold) 16%,transparent),transparent 42%),var(--aod2-primary-soft);text-align:center}
.aod2-purpose__seal{width:66px;height:66px;display:grid;place-items:center;border:1px solid var(--aod2-gold);border-radius:50%;background:var(--aod2-paper);color:var(--aod2-gold);box-shadow:0 8px 21px var(--aod2-shadow);font:27px Georgia,serif}
.aod2-purpose p{max-width:740px;margin:0;color:var(--aod2-primary-deep);font-size:1.14em;font-weight:650;line-height:2}
.aod2-purpose__support{margin-top:18px;padding:20px 23px;display:grid;grid-template-columns:28px 1fr;gap:12px;border:1px solid var(--aod2-line);border-radius:13px;background:var(--aod2-paper-2)}
.aod2-purpose__support>span{color:var(--aod2-gold)}
.aod2-purpose__support p{margin:0}

.aod2-conclusion-stack{display:grid;gap:13px}
.aod2-conclusion-stack>p{margin:0;padding:21px 24px;border:1px solid var(--aod2-line);border-radius:13px;background:var(--aod2-paper-2)}
.aod2-conclusion-stack__lead{display:flex;align-items:center;gap:14px!important;background:var(--aod2-primary)!important;color:#fff;font-size:1.08em;font-weight:700}
.aod2-conclusion-stack__lead span{color:var(--aod2-gold-2);font:20px Georgia,serif}

.aod2-dua__arch{min-height:585px;padding:clamp(35px,7vw,70px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:25px;border:1px solid color-mix(in srgb,var(--aod2-gold) 46%,transparent);border-radius:50% 50% 18px 18px/14% 14% 18px 18px;background:radial-gradient(circle at 50% 0,color-mix(in srgb,var(--aod2-gold) 18%,transparent),transparent 38%),var(--aod2-primary-soft);text-align:center}
.aod2-dua__mark{width:58px;height:58px;display:grid;place-items:center;border:1px solid var(--aod2-gold);border-radius:50%;background:var(--aod2-paper);color:var(--aod2-gold);font:25px Georgia,serif}
.aod2-dua__arch p{max-width:760px;margin:0}
.aod2-dua__arch i{width:120px;height:1px;background:linear-gradient(90deg,transparent,var(--aod2-gold),transparent)}
.aod2-dua__arch strong{min-width:130px;padding:10px 25px;border-radius:999px;background:var(--aod2-primary);color:#fff;font-size:1.3em}

.aod2-bottom-nav{margin:0 0 10px;padding:9px;display:grid;grid-template-columns:1fr auto 1fr;gap:8px;border:1px solid var(--aod2-line);border-radius:15px;background:color-mix(in srgb,var(--aod2-paper) 88%,transparent);box-shadow:0 13px 34px var(--aod2-shadow);backdrop-filter:blur(13px)}
.aod2-bottom-nav button{min-height:44px;padding:0 15px;display:flex;align-items:center;gap:10px;border:0;border-radius:9px;background:transparent;color:var(--aod2-primary);font-size:11px;cursor:pointer}
.aod2-bottom-nav button:hover{background:var(--aod2-primary-soft)}
.aod2-bottom-nav button:nth-child(2){justify-content:center;padding-inline:25px;background:var(--aod2-primary);color:#fff}
.aod2-bottom-nav button:last-child{justify-content:flex-end}

/* Terminal */
.aod2-terminal-backdrop{position:fixed;z-index:700;inset:0;background:rgba(4,14,12,.67);backdrop-filter:blur(10px);animation:aod2-fade .2s ease}
.aod2-terminal{position:fixed;z-index:710;top:0;right:0;width:min(450px,100%);height:100dvh;display:flex;flex-direction:column;background:linear-gradient(180deg,var(--aod2-terminal),var(--aod2-terminal-2));color:var(--aod2-terminal-text);box-shadow:-34px 0 85px rgba(0,0,0,.4);transform:translateX(105%);transition:transform .3s cubic-bezier(.2,.8,.2,1);overflow:hidden}
.aod2-terminal::before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.017) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.017) 1px,transparent 1px);background-size:26px 26px;mask-image:linear-gradient(#000,transparent 90%)}
.aod2-terminal.is-open{transform:translateX(0)}
.aod2-terminal__head{position:relative;z-index:1;min-height:123px;padding:26px 24px 20px;display:flex;align-items:flex-start;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.09);background:linear-gradient(135deg,rgba(255,255,255,.06),transparent)}
.aod2-terminal__head>div{display:grid}
.aod2-terminal__lights{display:flex;gap:5px;margin-bottom:8px}
.aod2-terminal__lights i{width:7px;height:7px;border-radius:50%;background:var(--aod2-terminal-muted)}
.aod2-terminal__lights i:first-child{background:#55d596;box-shadow:0 0 9px #55d596}
.aod2-terminal__lights i:nth-child(2){background:var(--aod2-gold)}
.aod2-terminal__head small{color:var(--aod2-terminal-muted);font:600 8px ui-monospace,monospace;letter-spacing:.12em}
.aod2-terminal__head h2{margin:4px 0 0;font:750 22px/1.2 ui-monospace,monospace;letter-spacing:-.03em}
.aod2-icon-button,.aod2-dialog__head>button{width:39px;height:39px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.12);border-radius:10px;background:rgba(255,255,255,.06);color:inherit;font:300 25px/1 ui-monospace,monospace;cursor:pointer}
.aod2-terminal__body{position:relative;z-index:1;flex:1;padding:14px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.17) transparent}
.aod2-term-group{margin-bottom:8px;border:1px solid rgba(255,255,255,.075);border-radius:13px;background:rgba(255,255,255,.032);overflow:hidden}
.aod2-term-group__trigger{width:100%;min-height:62px;padding:10px 13px;display:grid;grid-template-columns:34px 1fr auto 17px;align-items:center;gap:10px;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}
.aod2-term-group__trigger:hover{background:rgba(255,255,255,.04)}
.aod2-term-group__trigger>span{width:32px;height:32px;display:grid;place-items:center;border-radius:8px;background:rgba(255,255,255,.055);color:var(--aod2-gold-2)}
.aod2-term-group__trigger>b{font:650 12px ui-monospace,monospace}
.aod2-term-group__trigger>small{padding:4px 6px;border-radius:5px;background:rgba(255,255,255,.055);color:var(--aod2-terminal-muted);font:650 8px ui-monospace,monospace}
.aod2-term-group__trigger>i{color:var(--aod2-terminal-muted);font-style:normal;transition:transform .2s ease}
.aod2-term-group.is-open .aod2-term-group__trigger>i{transform:rotate(90deg)}
.aod2-term-group__panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .25s ease}
.aod2-term-group__panel>div{min-height:0;overflow:hidden}
.aod2-term-group.is-open .aod2-term-group__panel{grid-template-rows:1fr}
.aod2-term-group.is-open .aod2-term-group__panel>div{padding:0 8px 8px}
.aod2-term-label{display:block;padding:7px 9px 4px 44px;color:var(--aod2-terminal-muted);font:650 8px ui-monospace,monospace;letter-spacing:.13em}
.aod2-term-item{width:100%;min-height:57px;padding:8px 9px;display:grid;grid-template-columns:33px 1fr 16px;align-items:center;gap:10px;border:0;border-radius:9px;background:transparent;color:inherit;text-align:left;cursor:pointer}
.aod2-term-item:hover{background:rgba(255,255,255,.055)}
.aod2-term-item>span{width:31px;height:31px;display:grid;place-items:center;border-radius:8px;background:rgba(255,255,255,.05);color:var(--aod2-terminal-muted);font:650 11px ui-monospace,monospace}
.aod2-term-item>div{display:grid}
.aod2-term-item b,.aod2-term-toggle b{font:600 11px ui-monospace,monospace}
.aod2-term-item small,.aod2-term-toggle small{margin-top:2px;color:var(--aod2-terminal-muted);font:500 8px ui-monospace,monospace}
.aod2-term-item>i{color:var(--aod2-terminal-muted);font-style:normal}
.aod2-term-toggle{min-height:57px;padding:8px 9px 8px 52px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px;border-radius:9px;cursor:pointer}
.aod2-term-toggle:hover{background:rgba(255,255,255,.04)}
.aod2-term-toggle>div{display:grid}
.aod2-term-toggle input{position:absolute;width:1px;height:1px;opacity:0}
.aod2-term-toggle>span{position:relative;width:36px;height:20px;border-radius:20px;background:rgba(255,255,255,.14);transition:.2s ease}
.aod2-term-toggle>span i{position:absolute;left:3px;top:3px;width:14px;height:14px;border-radius:50%;background:var(--aod2-terminal-muted);transition:.2s ease}
.aod2-term-toggle input:checked+span{background:var(--aod2-gold)}
.aod2-term-toggle input:checked+span i{left:19px;background:var(--aod2-terminal-2)}
.aod2-terminal__foot{position:relative;z-index:1;min-height:52px;padding:0 20px;display:flex;align-items:center;gap:8px;border-top:1px solid rgba(255,255,255,.08);color:var(--aod2-terminal-muted);font:600 8px ui-monospace,monospace}
.aod2-terminal__foot b{padding:4px 7px;border-radius:5px;background:rgba(69,210,142,.13);color:#61dc9e;font-size:7px;letter-spacing:.08em}
.aod2-terminal__foot small{margin-left:auto}

/* Dialogs and report workspaces */
.aod2-dialog{width:min(1180px,calc(100% - 44px));max-width:none;max-height:calc(100dvh - 50px);padding:0;border:1px solid color-mix(in srgb,var(--aod2-gold) 32%,transparent);border-radius:19px;background:var(--aod2-paper);color:var(--aod2-ink);box-shadow:0 35px 100px rgba(0,0,0,.4);overflow:hidden}
.aod2-dialog[open]{display:flex;flex-direction:column;animation:aod2-rise .23s ease-out}
.aod2-dialog::backdrop{background:rgba(3,12,10,.68);backdrop-filter:blur(10px)}
.aod2-dialog__head{min-height:83px;padding:14px 20px;display:grid;grid-template-columns:47px 1fr 40px;gap:14px;align-items:center;background:linear-gradient(90deg,var(--aod2-primary-deep),var(--aod2-primary));color:#fff}
.aod2-dialog__head>span{width:44px;height:44px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.16);border-radius:11px;background:rgba(255,255,255,.08);color:var(--aod2-gold-2);font:650 16px ui-monospace,monospace}
.aod2-dialog__head small{color:rgba(255,255,255,.64);font:650 8px ui-monospace,monospace;letter-spacing:.12em}
.aod2-dialog__head h2{margin:3px 0 0;font-size:22px;line-height:1.2}
.aod2-report-view{min-height:0;flex:1;display:grid;grid-template-columns:minmax(285px,355px) 1fr;overflow:auto}
.aod2-report-controls{padding:23px;display:flex;flex-direction:column;gap:21px;border-right:1px solid var(--aod2-line);background:var(--aod2-paper-2);overflow:auto}
.aod2-report-controls fieldset{margin:0;padding:0;display:grid;gap:9px;border:0}
.aod2-report-controls legend{margin-bottom:7px;color:var(--aod2-muted);font:700 8px ui-monospace,monospace;letter-spacing:.11em}
.aod2-segment{padding:4px;display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:4px;border:1px solid var(--aod2-line);border-radius:9px;background:var(--aod2-paper)}
.aod2-segment button{min-height:35px;padding:5px 8px;border:0;border-radius:6px;background:transparent;color:var(--aod2-muted);font-size:10px;font-weight:700;cursor:pointer}
.aod2-segment button.is-active{background:var(--aod2-primary);color:#fff;box-shadow:0 5px 12px color-mix(in srgb,var(--aod2-primary) 20%,transparent)}
.aod2-primary-action{width:100%;min-height:48px;margin-top:auto;padding:0 16px;display:flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:10px;background:linear-gradient(135deg,var(--aod2-primary),var(--aod2-primary-deep));color:#fff;box-shadow:0 9px 23px color-mix(in srgb,var(--aod2-primary) 25%,transparent);font:700 11px ui-monospace,monospace;cursor:pointer}
.aod2-select{display:grid;gap:7px}
.aod2-select>span{color:var(--aod2-muted);font-size:9px;font-weight:700}
.aod2-select select{min-height:42px;padding:0 12px;border:1px solid var(--aod2-line);border-radius:8px;background:var(--aod2-paper);color:var(--aod2-ink);font-size:11px}
.aod2-palette-list{display:grid;gap:7px}
.aod2-palette-list button{min-height:41px;padding:6px 9px;display:flex;align-items:center;gap:9px;border:1px solid var(--aod2-line);border-radius:8px;background:var(--aod2-paper);color:var(--aod2-muted);font-size:10px;text-align:left;cursor:pointer}
.aod2-palette-list button.is-active{border-color:var(--aod2-gold);color:var(--aod2-primary);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--aod2-gold) 35%,transparent)}
.aod2-palette-list i{width:22px;height:22px;border:2px solid rgba(255,255,255,.7);border-radius:6px;background:var(--aod2-chip);box-shadow:0 0 0 1px rgba(0,0,0,.12)}
.aod2-print-preview,.aod2-canvas-stage{min-height:650px;padding:36px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(145deg,var(--aod2-bg),var(--aod2-bg-2));overflow:auto}
.aod2-print-workspace{display:block;width:100%;height:min(78vh,900px);min-height:650px;border:0;background:var(--aod2-bg)}
.aod2-mini-sheet{aspect-ratio:210/297;width:min(450px,77%);padding:10%;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;background:#fffdf5;color:#192c27;box-shadow:0 25px 55px rgba(0,0,0,.24);transition:.2s ease}
.aod2-mini-sheet>span{align-self:center;margin-bottom:10%;color:#bd8d32;font:40px Georgia,serif}
.aod2-mini-sheet small{color:#a07a30;font:700 7px ui-monospace,monospace;letter-spacing:.15em}
.aod2-mini-sheet h3{margin:4% 0;color:#0b624b;font-size:clamp(22px,3vw,36px);line-height:1.35}
.aod2-mini-sheet i{width:70px;height:3px;margin-bottom:7%;background:linear-gradient(90deg,#bd8d32,transparent)}
.aod2-mini-sheet p{margin:0;font-size:clamp(9px,1.1vw,13px);line-height:2}
.aod2-mini-sheet b{align-self:center;margin-top:9%;color:#bd8d32}
.aod2-print-preview>footer,.aod2-canvas-stage>footer{margin-top:16px;display:flex;gap:7px}
.aod2-print-preview>footer span,.aod2-canvas-stage>footer span{padding:5px 8px;border:1px solid var(--aod2-line);border-radius:999px;background:var(--aod2-paper);color:var(--aod2-muted);font:650 7px ui-monospace,monospace}
.aod2-canvas-stage canvas{display:block;max-width:min(730px,96%);max-height:585px;border-radius:5px;box-shadow:0 26px 68px rgba(0,0,0,.35);object-fit:contain}
.aod2-canvas-stage--wide canvas{border-radius:10px}

.aod2-appearance-dialog{width:min(840px,calc(100% - 44px))}
.aod2-appearance-view{padding:22px;overflow:auto}
.aod2-theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.aod2-theme-grid button{position:relative;min-height:125px;padding:11px;display:grid;grid-template-columns:1fr auto;align-items:end;gap:8px;border:1px solid var(--aod2-line);border-radius:13px;background:var(--aod2-paper-2);color:var(--aod2-ink);text-align:left;cursor:pointer}
.aod2-theme-grid button.is-active{border-color:var(--aod2-gold);box-shadow:inset 0 0 0 1px var(--aod2-gold)}
.aod2-theme-grid button>i{position:absolute;inset:10px 10px 46px;border-radius:8px;background:linear-gradient(90deg,var(--c1) 0 55%,var(--c2) 55% 82%,var(--c3) 82%);box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)}
.aod2-theme-grid button>span{display:grid}
.aod2-theme-grid b{font-size:12px}
.aod2-theme-grid small{color:var(--aod2-muted);font:600 7px ui-monospace,monospace}
.aod2-theme-grid em{color:var(--aod2-primary);font-style:normal}
.aod2-preset-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.aod2-preset-grid button{min-height:150px;padding:18px;display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:13px;border:1px solid var(--aod2-line);border-radius:13px;background:var(--aod2-paper-2);color:var(--aod2-ink);text-align:left;cursor:pointer}
.aod2-preset-grid button>i{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:var(--aod2-primary-soft);color:var(--aod2-primary);font-size:20px;font-style:normal}
.aod2-preset-grid button>span{display:grid;gap:6px}.aod2-preset-grid b{font-size:13px}.aod2-preset-grid small{color:var(--aod2-muted);font-size:9px;line-height:1.5}.aod2-preset-grid em{color:var(--aod2-primary);font-style:normal}
.aod2-preset-grid button.is-active{border-color:var(--aod2-gold);box-shadow:inset 0 0 0 1px var(--aod2-gold)}
.aod2-type-view{display:grid;gap:22px}
.aod2-font-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.aod2-font-grid button{min-height:100px;padding:12px;display:grid;align-content:center;gap:5px;border:1px solid var(--aod2-line);border-radius:11px;background:var(--aod2-paper-2);cursor:pointer}
.aod2-font-grid button.is-active{border-color:var(--aod2-gold);box-shadow:inset 0 0 0 1px var(--aod2-gold)}
.aod2-font-grid button:nth-child(1){font-family:"Noto Serif Bengali","Nirmala UI",serif}
.aod2-font-grid button:nth-child(2){font-family:"Noto Sans Bengali","Nirmala UI",sans-serif}
.aod2-font-grid button:nth-child(3){font-family:Kalpurush,SolaimanLipi,"Nirmala UI",serif}
.aod2-font-grid button b{color:var(--aod2-primary);font-size:19px}
.aod2-font-grid button small{color:var(--aod2-muted);font-size:9px}
.aod2-range{display:grid;gap:10px}
.aod2-range>span{display:flex;justify-content:space-between;align-items:center;font-size:11px}
.aod2-range output{min-width:54px;padding:5px 7px;border-radius:6px;background:var(--aod2-primary-soft);color:var(--aod2-primary);font:700 9px ui-monospace,monospace;text-align:center}
.aod2-range input{width:100%;accent-color:var(--aod2-primary)}
.aod2-type-sample{padding:19px;border:1px solid var(--aod2-line);border-radius:11px;background:var(--aod2-paper-2)}
.aod2-type-sample small{color:var(--aod2-muted);font:650 7px ui-monospace,monospace}
.aod2-type-sample p{margin:7px 0 0;font-size:var(--aod2-reader-size);line-height:var(--aod2-reader-leading)}

.aod2-contents-dialog{width:min(830px,calc(100% - 44px))}
.aod2-contents-grid{padding:13px;display:grid;grid-template-columns:1fr 1fr;gap:7px;overflow:auto}
.aod2-contents-grid button{min-height:69px;padding:9px 11px;display:grid;grid-template-columns:35px 1fr 18px;align-items:center;gap:10px;border:1px solid transparent;border-radius:9px;background:var(--aod2-paper-2);color:var(--aod2-ink);text-align:left;cursor:pointer}
.aod2-contents-grid button:hover,.aod2-contents-grid button.is-active{border-color:var(--aod2-gold);background:var(--aod2-primary-soft)}
.aod2-contents-grid button>span{color:var(--aod2-gold);font:750 9px ui-monospace,monospace}
.aod2-contents-grid button>div{display:grid}
.aod2-contents-grid small{color:var(--aod2-muted);font-size:8px}
.aod2-contents-grid b{color:var(--aod2-primary);font-size:12px}
.aod2-contents-grid i{color:var(--aod2-muted);font-style:normal}

@keyframes aod2-fade{from{opacity:0}}
@keyframes aod2-rise{from{opacity:0;transform:translateY(14px) scale(.985)}}

:root[data-aod2-motion="off"] *,
:root[data-aod2-motion="off"] *::before,
:root[data-aod2-motion="off"] *::after{scroll-behavior:auto!important;animation-duration:.001ms!important;transition-duration:.001ms!important}
:root[data-aod2-focus="on"] .aod2-read-state,
:root[data-aod2-focus="on"] .aod2-rail,
:root[data-aod2-focus="on"] .aod2-bottom-nav,
:root[data-aod2-focus="on"] .aod2-download{display:none}
:root[data-aod2-focus="on"] .aod2-topbar{grid-template-columns:1fr auto}
:root[data-aod2-focus="on"] .aod2-reader{padding-top:105px}

@media(max-width:1080px){
  .aod2-rail{display:none}
  .aod2-reader{width:min(930px,calc(100% - 44px))}
  .aod2-sheet--wide{width:100%;margin-left:0}
}

@media(max-width:760px){
  .aod2-topbar{top:9px;width:calc(100% - 18px);min-height:58px;padding:7px;grid-template-columns:1fr auto;border-radius:14px}
  .aod2-read-state{display:none}
  .aod2-brand__seal{width:32px;height:32px}
  .aod2-brand small{display:none}
  .aod2-download{min-height:41px;padding-inline:10px}
  .aod2-download span:last-child{display:none}
  .aod2-terminal-trigger{min-height:41px}
  .aod2-terminal-trigger kbd{display:none}
  .aod2-reader{width:calc(100% - 22px);padding-top:87px}
  .aod2-sheet{min-height:780px;margin-bottom:18px;padding:42px 30px 43px 34px;border-radius:4px 13px 13px 4px;box-shadow:-5px 8px 0 color-mix(in srgb,var(--aod2-paper-3) 72%,transparent),0 16px 38px var(--aod2-shadow)}
  .aod2-sheet::before{inset:9px}
  .aod2-sheet::after{width:47px;height:47px;right:12px;top:12px}
  .aod2-cover{min-height:calc(100vh - 105px);padding-block:42px}
  .aod2-cover__content{min-height:620px}
  .aod2-cover__mark{width:120px;height:120px;margin-bottom:30px}
  .aod2-cover h1{font-size:clamp(58px,18vw,82px)}
  .aod2-cover__statement{font-size:.84em}
  .aod2-section-head{grid-template-columns:52px 1fr;gap:14px;margin-bottom:34px}
  .aod2-section-head>div span{width:42px;height:42px}
  .aod2-section-head h2{font-size:clamp(27px,8vw,39px)}
  .aod2-compare,.aod2-check-grid,.aod2-prose-grid,.aod2-roadmap{grid-template-columns:1fr}
  .aod2-compare__card{min-height:260px}
  .aod2-question{grid-template-columns:42px 1fr;padding:20px 18px;gap:12px}
  .aod2-question>span{width:42px;height:42px}
  .aod2-lessons::before{left:24px}
  .aod2-lesson{grid-template-columns:49px 1fr;gap:10px}
  .aod2-lesson__index span{width:48px;height:48px}
  .aod2-lesson>div:last-child{padding:18px 15px;grid-template-columns:22px 1fr}
  .aod2-check-grid article{min-height:auto;padding:18px}
  .aod2-roadmap::before{display:none}
  .aod2-roadmap li:last-child{grid-column:auto;max-width:none}
  .aod2-equation{padding:22px 10px;gap:9px}
  .aod2-equation strong{font-size:28px}
  .aod2-equation small{font-size:8px}
  .aod2-quote{padding:25px 18px 25px 32px}
  .aod2-quote>span{left:-14px;width:31px;height:31px}
  .aod2-purpose{padding:32px 21px}
  .aod2-dua__arch{padding:38px 22px;border-radius:42% 42% 14px 14px/10% 10% 14px 14px}
  .aod2-bottom-nav{grid-template-columns:1fr 48px 1fr}
  .aod2-bottom-nav button{justify-content:center;padding:0 7px}
  .aod2-bottom-nav button:nth-child(2){padding:0}
  .aod2-bottom-nav button:nth-child(2) b{display:none}
  .aod2-bottom-nav button:last-child{justify-content:center}
  .aod2-dialog{width:calc(100% - 18px);max-height:calc(100dvh - 18px);border-radius:14px}
  .aod2-dialog__head{min-height:72px;padding:11px 12px;grid-template-columns:40px 1fr 37px}
  .aod2-dialog__head>span{width:38px;height:38px}
  .aod2-dialog__head h2{font-size:18px}
  .aod2-report-view{grid-template-columns:1fr;overflow-y:auto}
  .aod2-report-controls{border-right:0;border-bottom:1px solid var(--aod2-line);overflow:visible}
  .aod2-print-preview,.aod2-canvas-stage{min-height:420px;padding:24px 13px;overflow:visible}
  .aod2-canvas-stage canvas{max-width:100%}
  .aod2-theme-grid{grid-template-columns:1fr 1fr}
  .aod2-preset-grid{grid-template-columns:1fr}
  .aod2-font-grid{grid-template-columns:1fr}
  .aod2-font-grid button{min-height:75px}
  .aod2-contents-grid{grid-template-columns:1fr}
}

@media(max-width:430px){
  .aod2-terminal-trigger>span:not(.aod2-terminal-trigger__icon){display:none}
  .aod2-terminal-trigger{padding-inline:11px}
  .aod2-sheet{padding-inline:28px 22px}
  .aod2-section-head{grid-template-columns:1fr}
  .aod2-section-head>div{display:flex;align-items:center;gap:9px}
  .aod2-section-head>div small{margin:0}
  .aod2-cover__statement{font-size:.8em}
  .aod2-roadmap li{grid-template-columns:43px 1fr;padding:10px}
  .aod2-roadmap__num{width:41px;height:41px}
  .aod2-roadmap li>div{grid-template-columns:18px 1fr}
  .aod2-theme-grid{grid-template-columns:1fr}
}

@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.001ms!important;transition-duration:.001ms!important}}

/* --------------------------------------------------------------------------
   CLASSIC EDITION — book-first visual system
   -------------------------------------------------------------------------- */
:root{
  --aod2-classic-paper:color-mix(in srgb,var(--aod2-paper) 93%,#ead9b6 7%);
  --aod2-classic-paper-edge:color-mix(in srgb,var(--aod2-paper-3) 72%,var(--aod2-gold) 28%);
  --aod2-classic-rule:color-mix(in srgb,var(--aod2-gold) 53%,transparent);
  --aod2-classic-rule-soft:color-mix(in srgb,var(--aod2-gold) 23%,transparent);
  --aod2-classic-leather:var(--aod2-terminal);
  --aod2-classic-leather-deep:var(--aod2-terminal-2);
  --aod2-classic-radius:2px;
  --aod2-classic-measure:790px;
}

html{background:var(--aod2-bg-2)}
body{
  background:
    radial-gradient(circle at 8% 12%,color-mix(in srgb,var(--aod2-gold) 7%,transparent) 0 1px,transparent 2px),
    radial-gradient(circle at 92% 18%,color-mix(in srgb,var(--aod2-primary) 6%,transparent) 0 1px,transparent 2px),
    linear-gradient(115deg,color-mix(in srgb,var(--aod2-bg-2) 82%,#000 18%),var(--aod2-bg) 23%,var(--aod2-bg) 77%,color-mix(in srgb,var(--aod2-bg-2) 82%,#000 18%));
  background-size:53px 53px,67px 67px,100% 100%;
}

:root[data-aod2-font="classic"] .aod2-reader,
:root[data-aod2-font="book"] .aod2-reader{
  font-family:"Noto Serif Bengali",SolaimanLipi,Kalpurush,"Nirmala UI",Vrinda,serif;
}

.aod2-progress{height:2px;background:color-mix(in srgb,var(--aod2-classic-leather-deep) 30%,transparent)}
.aod2-progress span{background:linear-gradient(90deg,var(--aod2-gold),var(--aod2-gold-2),var(--aod2-gold))}

.aod2-topbar{
  top:14px;
  width:min(1090px,calc(100% - 52px));
  min-height:58px;
  padding:6px 8px 6px 10px;
  border:1px solid var(--aod2-classic-rule);
  border-radius:4px;
  background:color-mix(in srgb,var(--aod2-classic-leather) 94%,transparent);
  color:var(--aod2-terminal-text);
  box-shadow:0 3px 0 var(--aod2-gold),0 14px 35px rgba(17,13,8,.26);
  backdrop-filter:blur(14px);
}
.aod2-topbar::before,
.aod2-topbar::after{
  content:"";
  position:absolute;
  top:8px;
  bottom:8px;
  width:1px;
  background:linear-gradient(transparent,var(--aod2-gold),transparent);
  opacity:.65;
}
.aod2-topbar::before{left:58px}
.aod2-topbar::after{right:116px}
.aod2-brand{color:var(--aod2-terminal-text)}
.aod2-brand__seal{
  width:34px;height:34px;
  border:1px solid var(--aod2-gold-2);
  border-radius:50%;
  background:transparent;
  box-shadow:inset 0 0 0 3px color-mix(in srgb,var(--aod2-gold) 14%,transparent);
  color:var(--aod2-gold-2);
}
.aod2-brand strong{font-family:"Noto Serif Bengali",SolaimanLipi,"Nirmala UI",serif;font-size:14px;font-weight:700;letter-spacing:.02em}
.aod2-brand small{color:var(--aod2-terminal-muted);letter-spacing:.18em}
.aod2-read-state{color:var(--aod2-terminal-muted)}
.aod2-read-state__dot{width:5px;height:5px;background:var(--aod2-gold-2);box-shadow:0 0 0 3px color-mix(in srgb,var(--aod2-gold) 15%,transparent)}
.aod2-read-state b{border:1px solid rgba(255,255,255,.09);border-radius:2px;background:rgba(255,255,255,.045);color:var(--aod2-gold-2)}
.aod2-download{
  min-height:40px;
  border:1px solid rgba(255,255,255,.11);
  border-radius:2px;
  background:rgba(255,255,255,.045);
  color:var(--aod2-gold-2);
}
.aod2-download:hover{border-color:var(--aod2-gold);background:rgba(255,255,255,.08)}
.aod2-terminal-trigger{
  min-height:40px;
  border:1px solid var(--aod2-classic-rule);
  border-radius:2px;
  background:linear-gradient(180deg,color-mix(in srgb,var(--aod2-terminal-2) 90%,#fff 10%),var(--aod2-terminal-2));
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.035),0 5px 12px rgba(0,0,0,.25);
}
.aod2-terminal-trigger__icon,.aod2-terminal-trigger kbd{border-radius:2px}

.aod2-rail{right:max(14px,calc((100vw - 1190px)/2));gap:8px}
.aod2-rail__track{height:28px;background:linear-gradient(transparent,var(--aod2-gold),transparent);opacity:.55}
.aod2-rail button{width:26px;height:26px;border-radius:50%;color:color-mix(in srgb,var(--aod2-primary) 65%,var(--aod2-gold) 35%)}
.aod2-rail button::before{width:4px;height:4px;background:var(--aod2-gold)}
.aod2-rail button:hover,.aod2-rail button.is-active{
  border:1px solid var(--aod2-gold);
  background:var(--aod2-classic-leather);
  box-shadow:inset 0 0 0 2px color-mix(in srgb,var(--aod2-gold) 12%,transparent),0 4px 10px rgba(0,0,0,.18);
}

.aod2-reader{
  width:min(940px,calc(100% - 76px));
  padding:106px 0 46px;
  font-size:var(--aod2-reader-size);
  line-height:var(--aod2-reader-leading);
}
.aod2-sheet,
.aod2-sheet--wide{
  width:100%;
  min-height:900px;
  margin:0 0 43px;
  padding:clamp(72px,8vw,104px) clamp(54px,9vw,104px) 66px;
  border:1px solid var(--aod2-classic-paper-edge);
  border-radius:var(--aod2-classic-radius);
  background:
    radial-gradient(circle at 17% 23%,rgba(115,82,39,.035) 0 1px,transparent 1.3px),
    radial-gradient(circle at 71% 67%,rgba(115,82,39,.025) 0 1px,transparent 1.2px),
    linear-gradient(90deg,rgba(83,57,26,.045),transparent 4.5%,transparent 95.5%,rgba(83,57,26,.03)),
    var(--aod2-classic-paper);
  background-size:49px 49px,61px 61px,100% 100%,100% 100%;
  box-shadow:
    -8px 10px 0 var(--aod2-classic-paper-edge),
    -13px 17px 0 color-mix(in srgb,var(--aod2-bg-2) 70%,#000 4%),
    0 30px 70px rgba(34,25,15,.23),
    inset 18px 0 28px -30px rgba(60,39,16,.5);
  scroll-margin-top:92px;
  overflow:hidden;
}
.aod2-sheet::before{
  inset:18px;
  border:1px solid var(--aod2-classic-rule);
  border-radius:0;
  box-shadow:inset 0 0 0 4px var(--aod2-classic-paper),inset 0 0 0 5px var(--aod2-classic-rule-soft);
}
.aod2-sheet::after{
  content:"";
  right:50%;
  top:28px;
  width:38px;
  height:28px;
  display:grid;
  place-items:center;
  border:0;
  border-radius:0;
  background:var(--aod2-classic-paper);
  color:var(--aod2-gold);
  font:18px/1 Georgia,serif;
  opacity:.86;
  transform:translateX(50%);
}
.aod2-sheet>*{position:relative;z-index:1}
.aod2-sheet> :is(.aod2-section-head,.aod2-opening,.aod2-compare,.aod2-question,.aod2-lessons,.aod2-check-grid,.aod2-next-note,.aod2-special,.aod2-equation,.aod2-quote,.aod2-prose-grid,.aod2-behaviour,.aod2-purpose,.aod2-purpose__support,.aod2-conclusion-stack,.aod2-dua__arch){max-width:var(--aod2-classic-measure);margin-left:auto;margin-right:auto}
.aod2-sheet__frame{inset:29px;border:1px solid var(--aod2-classic-rule-soft);border-radius:0}
.aod2-sheet__folio{left:70px;right:70px;bottom:31px;color:var(--aod2-gold);letter-spacing:.18em}
.aod2-sheet__folio::before,.aod2-sheet__folio::after{width:110px;background:linear-gradient(90deg,transparent,var(--aod2-gold))}
.aod2-sheet__folio::after{background:linear-gradient(90deg,var(--aod2-gold),transparent)}
.aod2-sheet__folio b{color:var(--aod2-muted);font-family:Georgia,serif;font-size:9px}

.aod2-cover{
  min-height:calc(100vh - 130px);
  padding:52px;
  border:1px solid var(--aod2-gold);
  background:
    radial-gradient(ellipse at 50% 36%,color-mix(in srgb,var(--aod2-gold) 11%,transparent),transparent 38%),
    repeating-linear-gradient(0deg,rgba(255,255,255,.015) 0 1px,transparent 1px 4px),
    repeating-linear-gradient(90deg,rgba(0,0,0,.025) 0 1px,transparent 1px 5px),
    linear-gradient(145deg,var(--aod2-classic-leather),var(--aod2-classic-leather-deep));
  color:var(--aod2-terminal-text);
  box-shadow:-10px 12px 0 color-mix(in srgb,var(--aod2-classic-leather-deep) 88%,#000 12%),-17px 20px 0 var(--aod2-classic-paper-edge),0 33px 80px rgba(0,0,0,.38),inset 0 0 55px rgba(0,0,0,.22);
}
.aod2-cover::before{
  inset:20px;
  border:1px solid var(--aod2-gold);
