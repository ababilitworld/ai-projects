/* Front matter, chapter system and collector-style cover. */
.aod2-cover__content{
  position:relative;
  isolation:isolate;
}
.aod2-cover__content::before,
.aod2-cover__content::after{
  content:"";
  position:absolute;
  z-index:-1;
  pointer-events:none;
}
.aod2-cover__content::before{
  inset:54px 10%;
  border:1px solid color-mix(in srgb,var(--aod2-gold) 64%,transparent);
  border-radius:48% 48% 3px 3px/15% 15% 3px 3px;
  box-shadow:
    inset 0 0 0 6px transparent,
    inset 0 0 0 7px color-mix(in srgb,var(--aod2-gold) 20%,transparent),
    0 0 55px color-mix(in srgb,var(--aod2-gold) 6%,transparent);
}
.aod2-cover__content::after{
  top:93px;
  left:50%;
  width:min(550px,72%);
  height:1px;
  background:linear-gradient(90deg,transparent,var(--aod2-gold),transparent);
  box-shadow:0 530px 0 color-mix(in srgb,var(--aod2-gold) 65%,transparent);
  transform:translateX(-50%);
  opacity:.7;
}
.aod2-cover__edition{
  position:absolute;
  top:8px;
  left:50%;
  width:min(470px,74%);
  display:grid;
  grid-template-columns:auto 1fr auto;
  align-items:center;
  gap:14px;
