/* Final folio cascade: keep the interrupted running line in reader and PDF. */
@media screen{
  html:root[data-aod2-theme="ait-pha"] .aod2-sheet__folio{
    z-index:12!important;left:var(--aod2-page-inner-inset)!important;right:var(--aod2-page-inner-inset)!important;
    bottom:calc(var(--aod2-page-inner-inset) - 7px)!important;display:flex!important;align-items:center!important;
    justify-content:space-between!important;gap:0!important;padding:0!important;border:0!important;line-height:1.2!important;
  }
  html:root[data-aod2-theme="ait-pha"] .aod2-sheet__folio::before{
    content:""!important;position:absolute!important;z-index:0!important;left:0!important;right:0!important;top:50%!important;
    width:auto!important;height:1px!important;display:block!important;background:var(--aod2-page-frame-soft)!important;
    transform:translateY(-50%)!important;
  }
  html:root[data-aod2-theme="ait-pha"] .aod2-sheet__folio::after{display:none!important}
  html:root[data-aod2-theme="ait-pha"] .aod2-sheet__folio>span,
  html:root[data-aod2-theme="ait-pha"] .aod2-sheet__folio>b{
    position:relative!important;z-index:1!important;display:inline-flex!important;align-items:center!important;
    min-width:0!important;min-height:20px!important;margin-inline:clamp(18px,2.7vw,34px)!important;padding:2px 8px!important;
