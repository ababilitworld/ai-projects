    background:color-mix(in srgb,var(--aod2-primary-soft) 72%,var(--aod2-page-paper));
    color:var(--aod2-primary-deep);
    box-shadow:0 0 0 5px color-mix(in srgb,var(--aod2-page-paper) 82%,transparent),0 13px 34px color-mix(in srgb,var(--aod2-primary) 13%,transparent);
