  .aod2-roadmap{--aod2-flow-node-size:48px;--aod2-flow-node-radius:24px;--aod2-flow-axis:24px;--aod2-flow-stroke:5px;--aod2-flow-arrow-width:16px;--aod2-flow-arrow-height:11px;position:relative;max-width:none;padding:0;grid-template-columns:1fr;gap:26px;margin:0 auto;list-style:none}
